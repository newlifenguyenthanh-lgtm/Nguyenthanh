# Copy to .env (never commit .env). Placeholders only.
PAACC_DATABASE_URL=postgresql+psycopg://paacc:CHANGE_ME@localhost:5432/paacc
PAACC_DEFAULT_AI_PROVIDER=echo        # echo | anthropic | openai | local
PAACC_ANTHROPIC_API_KEY=
PAACC_OPENAI_API_KEY=
PAACC_LOCAL_MODEL_URL=http://localhost:11434/v1   # OpenAI-compatible (Ollama, vLLM, llama.cpp)
PAACC_JWT_SECRET=            # required: long random string, never commit
